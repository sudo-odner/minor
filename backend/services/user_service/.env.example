# Окружение (local, dev, prod)
ENV="local"

# SERVER Setting
# http
# Required
HTTP_SERVER_ADDRESS=:8084
# Optional
HTTP_SERVER_TIMEOUT=4s
HTTP_SERVER_IDLE_TIMEOUT=60s

# gRPC 
# Required
GRPC_SERVER_ADDRESS=:50051
# Optional
GRPC_SERVER_TIMEOUT=4s


# BROCKER Setting
# Nuts 
# Required
NUTS_URL="nats://127.0.0.1:4222"
# Optional
NUTS_TIMEOUT=10s
NUTS_MAX_RECONNECTS=5
NUTS_TIMEOUT_RECONNECTS=2s


# REPOSITORY Setting
# Postgres 
POSTGRES_HOST="user-postgres"
POSTGRES_PORT=5432
POSTGRES_USER="user_service"
POSTGRES_PASSWORD="user_service_master_key"
POSTGRES_DATABASE="user_service"
